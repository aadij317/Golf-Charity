# --- Supabase (from Project Settings > API on YOUR new Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# --- Stripe (test mode keys from the Stripe Dashboard) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# --- App URL, used for Stripe Checkout success/cancel redirects ---
NEXT_PUBLIC_APP_URL=

# --- Email (Resend — https://resend.com) ---
# Powers PRD §13 "system updates, draw results, winner alerts."
# Optional for local dev: if RESEND_API_KEY is unset, emails are logged
# to the console instead of sent (see lib/email.ts) so the app still runs
# without a provider configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Digital Heroes <onboarding@resend.dev>